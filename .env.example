# Copy to .env (or run `make env`, which also generates a SECRET_KEY).
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the site is served over HTTPS behind a proxy, e.g. https://status.example.com
CSRF_TRUSTED_ORIGINS=
# TIME_ZONE=UTC
# RESULT_RETENTION_DAYS=90
# Host port published by docker compose
PORT=8000
