# Used by compose.production.yaml. `make prod-env` copies this to .env and replaces every
# "change-me" with a different random value.

SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# Public address. A real domain gets a Let's Encrypt certificate automatically;
# status.localhost uses Caddy's local CA (good for trying it out).
SITE_ADDRESS=status.localhost
ALLOWED_HOSTS=status.localhost
CSRF_TRUSTED_ORIGINS=https://status.localhost

# Host ports published by Caddy. Use 80 and 443 on a real server.
HTTP_PORT=80
HTTPS_PORT=443

# POSTGRES_DB=uptime
# POSTGRES_USER=uptime
# TIME_ZONE=UTC
# RESULT_RETENTION_DAYS=90
